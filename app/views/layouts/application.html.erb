<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Календарь встреч" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="container topbar__inner">
        <%= link_to "📅 Календарь встреч", root_path, class: "brand" %>
        <nav class="nav">
          <%= link_to "Встречи", meetings_path, class: "nav__link" %>
          <%= link_to "Сотрудники", employees_path, class: "nav__link" %>
          <%= link_to "+ Новая встреча", new_meeting_path, class: "btn btn--primary" %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice %>
        <div class="flash flash--notice"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="flash flash--alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
